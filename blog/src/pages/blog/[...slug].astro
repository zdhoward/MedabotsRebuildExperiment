---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} — Medabots Rebuild Devlog`}>
  <article class={`arch-${post.data.archetype}`}>
    <div class="accent-bar" aria-hidden="true"></div>
    <h2 class="post-title">{post.data.title}</h2>
    <div class="meta">
      <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
        {post.data.pubDate.toISOString().slice(0, 10)}
      </time>
      <span class="chip">{post.data.archetype}</span>
      <span class="chip">{post.data.task_id}</span>
      <span class={`chip status-${post.data.status}`}>{post.data.status}</span>
      <span class="chip">commit {post.data.commit_sha}</span>
    </div>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
