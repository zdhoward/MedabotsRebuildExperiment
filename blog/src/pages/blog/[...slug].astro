---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

const post = Astro.props;
const { Content } = await render(post);
---
<Base title={`${post.data.title} — Medabots Rebuild Devlog`}>
  <article>
    <h2>{post.data.title}</h2>
    <p>
      <small>
        {post.data.pubDate.toISOString().slice(0, 10)} · task {post.data.task_id} ·
        archetype {post.data.archetype} · status {post.data.status} ·
        commit {post.data.commit_sha}
      </small>
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
