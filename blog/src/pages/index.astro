---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Base title="Medabots Rebuild Experiment — Devlog">
  <section>
    <h2>All posts</h2>
    <ol class="post-list">
      {posts.map((post) => (
        <li class={`post-card arch-${post.data.archetype}`}>
          <a class="post-card-title" href={`/blog/${post.id}/`}>
            {post.data.title}
          </a>
          <div class="meta">
            <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
              {post.data.pubDate.toISOString().slice(0, 10)}
            </time>
            <span class="chip">{post.data.archetype}</span>
            <span class="chip">{post.data.task_id}</span>
            <span class={`chip status-${post.data.status}`}>{post.data.status}</span>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>
