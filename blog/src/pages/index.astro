---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Base title="Medabots Rebuild Experiment — Devlog">
  <section>
    <h2>All posts</h2>
    <ul>
      {posts.map((post) => (
        <li>
          <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>
            {post.data.pubDate.toISOString().slice(0, 10)}
          </time>
          &nbsp;<a href={`/blog/${post.id}/`}>{post.data.title}</a>
          <small>
            &nbsp;[{post.data.archetype} · {post.data.task_id} · {post.data.status}]
          </small>
        </li>
      ))}
    </ul>
  </section>
</Base>
